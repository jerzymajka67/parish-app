<body>
  <main>

    <!-- HERO -->
    <section class="hero-section">
      <div class="container">
        <h1 class="display-5 fw-bold">Horario de Misas</h1>
        <p class="lead">Parroquia Nuestra Señora Reina de los Ángeles y Misiones</p>
      </div>
    </section>

    <div class="container my-5">

      <!-- Sábado -->
      <section class="mb-5">
        <h2 class="section-title">Sábado</h2>

        <div class="card shadow-sm border-0">
          <img src="/images/missions/olqa.webp"
               class="card-img-top"
               alt="Iglesia Nuestra Señora Reina de los Ángeles">

          <div class="card-body">
            <h5 class="fw-bold">Nuestra Señora Reina de los Ángeles – La Joya</h5>
            <p class="mb-1">916 S. Leo Ave., La Joya, TX 78560</p>
            <p class="mb-1">4:00 – 4:50 p.m. Confesiones</p>
            <p class="mb-0">5:00 p.m. – Español</p>
          </div>
        </div>
      </section>

      <!-- Domingo -->
      <section class="mb-5">
        <h2 class="section-title">Domingo</h2>

        <div class="row g-4">

          <!-- Santa María Magdalena -->
          <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0">
              <img src="/images/missions/st-mary-magdalene.webp"
                   class="card-img-top"
                   alt="Misión Santa María Magdalena">

              <div class="card-body">
                <h6 class="fw-bold">Santa María Magdalena</h6>
                <p class="small mb-1">
                  7100 Military Rd., Mission, TX
                  <a href="https://www.google.com/maps/search/?api=1&query=7100+Military+Rd+Mission+TX"
                     target="_blank"
                     class="ms-1 text-decoration-none">
                     <i class="bi bi-geo-alt-fill text-danger"></i>
                  </a>
                </p>
                <p class="small mb-0">8:30 a.m. – Bilingüe</p>
              </div>
            </div>
          </div>

          <!-- San Antonio de Padua -->
          <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0">
              <img src="/images/missions/st-anthony-padua.webp"
                   class="card-img-top"
                   alt="Misión San Antonio de Padua">

              <div class="card-body">
                <h6 class="fw-bold">San Antonio de Padua</h6>
                <p class="small mb-1">
                  1102 S. Main St., Peñitas, TX
                  <a href="https://www.google.com/maps/search/?api=1&query=1102+S+Main+St+Penitas+TX"
                     target="_blank"
                     class="ms-1 text-decoration-none">
                     <i class="bi bi-geo-alt-fill text-danger"></i>
                  </a>
                </p>
                <p class="small mb-0">10:00 a.m. – Bilingüe</p>
              </div>
            </div>
          </div>

          <!-- Nuestra Señora Reina de los Ángeles -->
          <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0">
              <img src="/images/missions/olqa.webp"
                   class="card-img-top"
                   alt="Nuestra Señora Reina de los Ángeles">

              <div class="card-body">
                <h6 class="fw-bold">Nuestra Señora Reina de los Ángeles</h6>
                <p class="small mb-1">
                  916 S. Leo Ave., La Joya, TX
                  <a href="https://maps.app.goo.gl/mrYbCELxQyLUp7x9A"
                     target="_blank"
                     class="ms-1 text-decoration-none">
                     <i class="bi bi-geo-alt-fill text-danger"></i>
                  </a>
                </p>
                <p class="small mb-0">11:30 a.m. – Inglés</p>
              </div>
            </div>
          </div>

          <!-- San José -->
          <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0">
              <img src="/images/missions/st-joseph-havana.webp"
                   class="card-img-top"
                   alt="Misión San José">

              <div class="card-body">
                <h6 class="fw-bold">San José</h6>
                <p class="small mb-1">
                  41838 Old Military Rd., Havana, TX
                  <a href="https://www.google.com/maps/search/?api=1&query=41838+Old+Military+Rd+Havana+TX"
                     target="_blank"
                     class="ms-1 text-decoration-none">
                     <i class="bi bi-geo-alt-fill text-danger"></i>
                  </a>
                </p>
                <p class="small mb-0">2:00 p.m. – Español</p>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- Misas entre semana -->
      <section class="mb-5">
        <h2 class="section-title">Misas entre semana</h2>
        <p>
          Martes – 6:00 p.m. – Peñitas<br>
          Miércoles – 6:00 p.m. – La Joya<br>
          Jueves – 6:00 p.m. – Abram
        </p>
      </section>

      <!-- Confesiones y Hora Santa -->
      <section class="mb-5">
        <h2 class="section-title">Confesiones y Hora Santa</h2>
        <p>
          Martes – 5:00 p.m. – 6:00 p.m. – Peñitas<br>
          Miércoles – 5:00 p.m. – 6:00 p.m. – La Joya<br>
          Jueves – 5:00 p.m. – 6:00 p.m. – Abram
        </p>
      </section>

      <!-- Aviso -->
      <div class="construction-note">
        <strong>Nota:</strong><br>
        Los horarios de misa pueden cambiar durante días festivos
        o celebraciones especiales. Consulte los anuncios parroquiales
        o nuestra página de Facebook para actualizaciones.
      </div>

    </div>

  </main>
</body>
