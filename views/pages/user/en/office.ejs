<body>
  <main>

    <!-- HERO -->
    <section class="hero-section">
      <div class="container">
        <h1 class="display-5 fw-bold">Parish Office</h1>
        <p class="lead">Here to Serve Our Parish Family</p>
      </div>
    </section>

    <div class="container my-5">

      <!-- Welcome -->
      <section class="mb-5">
        <h2 class="section-title">Welcome</h2>
        <p>
          The Parish Office is here to assist you with sacramental preparation,
          parish information, certificates, and any questions you may have.
          We are honored to serve our parish community with dedication and care.
        </p>
        <p>
          Our staff and volunteers strive to create a welcoming environment
          where every person is received with kindness, patience, and respect.
        </p>
      </section>

      <!-- Contact Information + Outdoor Photo -->
      <section class="mb-5">
        <h2 class="section-title">Office Contact Information</h2>

        <div class="row g-4 align-items-stretch">

          <!-- Photo LEFT -->
          <div class="col-md-6">
            <img src="/images/parish/office-outdoor.webp"
                 class="img-fluid rounded shadow-sm section-photo"
                 alt="Parish Office Exterior">
          </div>

          <!-- Contact Card RIGHT -->
          <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
              <div class="card-body">

                <p class="mb-3">
                  <i class="bi bi-geo-alt-fill text-danger me-2"></i>
                  <strong>Address:</strong><br>
                  916 S. Leo Ave., La Joya, TX 78560
                  <a href="https://maps.app.goo.gl/mrYbCELxQyLUp7x9A"
                     target="_blank"
                     class="ms-2 text-decoration-none">
                     <i class="bi bi-map"></i>
                  </a>
                </p>

                <p class="mb-3">
                  <i class="bi bi-telephone-fill text-primary me-2"></i>
                  <strong>Phone:</strong><br>
                  <a href="tel:9565855223" class="text-decoration-none">
                    956-585-5223
                  </a>
                </p>

                <p class="mb-0">
                  <i class="bi bi-envelope-fill text-primary me-2"></i>
                  <strong>Email:</strong><br>
                  <a href="mailto:olqangels@cdob.org" class="text-decoration-none">
                    olqangels@cdob.org
                  </a>
                </p>

              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- Office Hours -->
      <section class="mb-5">
        <h2 class="section-title">Office Hours</h2>

        <div class="card shadow-sm border-0">
          <div class="card-body">

            <p class="mb-3">
              <strong>Monday – Friday</strong><br>
              10:00 a.m. – 1:00 p.m.<br>
              2:00 p.m. – 6:00 p.m.
            </p>

            <p class="mb-3">
              <strong>Saturday</strong><br>
              10:00 a.m. – 12:00 p.m.
            </p>

            <p class="mb-0 text-muted small">
              On Mondays and Saturdays, our office is assisted by dedicated parish volunteers.
            </p>

          </div>
        </div>
      </section>

      <!-- Staff + Indoor Photo -->
      <section class="mb-5">
        <h2 class="section-title">Parish Staff</h2>

        <div class="row g-4 align-items-stretch">

          <!-- Photo LEFT -->
          <div class="col-md-6">
            <img src="/images/parish/office-indoor.webp"
                 class="img-fluid rounded shadow-sm section-photo"
                 alt="Parish Office Interior">
          </div>

          <!-- Staff Card RIGHT -->
          <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
              <div class="card-body">

                <p class="mb-2">
                  <strong>Fr. Jerzy Majka</strong><br>
                  Pastor
                </p>

                <p class="mb-2">
                  <strong>Mrs. Thelma Yadira Garcia</strong><br>
                  Parish Catechetical Leader (PCL)
                </p>

                <p class="mb-0">
                  <strong>Mrs. Carina Gonzalez</strong><br>
                  Receptionist / Secretary
                </p>

              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- Appreciation -->
      <div class="construction-note">
        <strong>With Gratitude:</strong><br>
        We are deeply thankful for our parish volunteers who generously give
        their time and talents to support the daily work of our office.
        Their service is a true expression of Christian charity.
      </div>

    </div>

  </main>
</body>
