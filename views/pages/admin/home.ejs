<body>
  <h2><%= title %></h2>

  <div class="container-fluid">
    <div class="row">

      <!-- LEFT COLUMN: ACTIONS -->
      <div class="col-md-4 border-end p-3">

        <!-- Upload -->
        <form id="uploadHtmlForm"
              action="/admin/home/upload-file"
              method="POST"
              enctype="multipart/form-data"
              class="mb-3 d-flex flex-column gap-2">
          <button type="submit" class="btn btn-success">
            Upload HTML File
          </button>
          <input type="file"
                 name="html"
                 accept=".html"
                 required
                 class="form-control">
        </form>

        <!-- Create -->
        <form id="createHtmlForm"
              action="/admin/home/create-html"
              method="POST"
              class="mb-2 d-flex flex-column gap-2">
          <button type="submit" class="btn btn-success">
            Create HTML
          </button>
          <input type="text"
                 name="fileName"
                 placeholder="New HTML file name"
                 required
                 class="form-control">
        </form>

        <!-- Rename -->
        <form id="renameForm"
              action="/admin/home/rename"
              method="POST"
              class="d-flex flex-column gap-2">
          <input id="renameOldName" type="hidden" name="fileName">
          <button type="submit" class="btn btn-amber">
            Rename
          </button>
          <input id="renameNewName"
                 type="text"
                 name="newName"
                 placeholder="New file name"
                 required
                 class="form-control">
        </form>

        <!-- Edit -->
        <button id="editBtn"
                type="button"
                class="btn btn-secondary w-100 mt-3">
          Edit
        </button>

        <!-- View -->
        <form id="viewForm"
              action="/admin/home/view"
              method="GET"
              target="_blank"
              class="d-grid gap-2 mt-3">
          <input id="viewFileName"
                 type="hidden"
                 name="fileName">
          <button type="submit"
                  class="btn btn-outline-secondary">
            View
          </button>
        </form>

        <!-- Publish -->
        <div class="d-flex gap-2 mt-3 mb-2">

          <form id="publishEnForm"
                action="/admin/home/publish-en"
                method="POST"
                class="flex-fill">
            <input id="publishEN"
                   type="hidden"
                   name="fileName">
            <button type="submit"
                    class="btn btn-primary w-100">
              Publish EN
            </button>
          </form>

          <form id="publishEsForm"
                action="/admin/home/publish-es"
                method="POST"
                class="flex-fill">
            <input id="publishES"
                   type="hidden"
                   name="fileName">
            <button type="submit"
                    class="btn btn-primary w-100">
              Publish ES
            </button>
          </form>

        </div>

        <!-- Delete -->
        <form id="deleteForm"
              method="POST"
              action="/admin/home/delete-file"
              class="mb-3 d-flex gap-2 align-items-center">

          <button type="button"
                  class="btn btn-danger"
                  id="deleteBtn">
            Delete
          </button>

          <input id="deleteFileName"
                 type="hidden"
                 name="fileName">
        </form>

      </div>


      <!-- RIGHT COLUMN -->
      <div class="col-md-8 p-4">
        <h4>Files</h4>

        <div class="row mt-3">

          <!-- FILE BROWSER -->
          <div class="col-md-7">
            <div class="border p-3">
              <div id="browser-container">
                <div id="browser" class="list-group">
                  <!-- dynamically inserted items -->
                </div>
              </div>
            </div>
          </div>

          <!-- WELCOME PANEL -->
          <div class="col-md-5">

            <div class="border p-3 mb-3 bg-light">

              <% if (msg && status) { %>
                <div id="server-feedback"
                     class="server-feedback <%= status %> border p-3 mt-3">
                  <%= msg %>
                </div>
              <% } %>

              <h5>Welcome, Samantha & Catalina!</h5>

              <p>
                This page allows you to manage the
                <strong>Home Page</strong> of our parish website.
              </p>

              <p class="small">
                The Home Page is the first message visitors see.
                It should be warm, welcoming, and spiritually meaningful.
                Its main purpose is to greet people and communicate
                important seasonal or liturgical information.
              </p>

              <ul class="small">
                <li>You may <strong>upload existing HTML files</strong> or create new ones.</li>
                <li>You can <strong>edit files safely</strong> using the editor.</li>
                <li>The original file is never modified.</li>
                <li>When you edit a file, the system creates a new version with the same name plus the <strong>date and time of editing</strong>.</li>
                <li>After reviewing your changes in <strong>View mode</strong>, you may publish the page in <strong>English (EN)</strong> or <strong>Spanish (ES)</strong>.</li>
              </ul>

              <p class="small">
                The Home Page should normally include:
              </p>

              <ul class="small">
                <li>A welcoming message to parishioners and visitors.</li>
                <li>Information about the current <strong>liturgical season</strong> (for example: Lent, Advent, Easter).</li>
                <li>Announcements of special celebrations (for example: Ash Wednesday, Holy Week, Christmas Masses).</li>
              </ul>

              <p class="small mb-0">
                Thank you for your dedication and generosity
                in serving our parish community.
              </p>

            </div>
          </div>
        </div>
      </div>
    </div>
  </div>


  <!-- CONFIRM DELETE MODAL -->
  <div class="modal fade" id="confirmDeleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Confirm delete</h5>
          <button class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          Delete <strong id="modal-folder-name"></strong>?
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
        </div>
      </div>
    </div>
  </div>


  <!-- TINYMCE EDITOR MODAL -->
  <div class="modal fade" id="editHtmlModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 id="editorTitle" class="modal-title"></h5>
        </div>
        <div id="editor" class="modal-body"></div>
        <div class="modal-footer">
          <button id="saveOnlyBtn" class="btn btn-success">Save</button>
          <button id="saveExitBtn"
                  class="btn btn-secondary"
                  data-bs-dismiss="modal">
            Save & Exit
          </button>
        </div>
      </div>
    </div>
  </div>


  <script>
    document.addEventListener('DOMContentLoaded', () => {
      window.selectedFile = null;
      fetchFileList('/admin/home/ls');
      initDeleteModal();

      if (document.getElementById('editHtmlModal')) {
        initEditor();
        initEditButton();
      }
    });

    (function () {
      const feedback = document.getElementById('server-feedback');
      if (!feedback) return;

      setTimeout(() => {
        feedback.remove();
      }, 7000);
    })();
  </script>

</body>
