<body>
  <h2><%= title %></h2>
  <div class="container-fluid">
    <div class="row">
<!-- LEFT COLUMN: ACTIONS -->
      <div class="col-md-4 border-end p-3">
        <!-- Upload -->
        <form id="uploadHtmlForm"
              action="/admin/<%= page %>/upload-file"
              method="POST"
              enctype="multipart/form-data"
              class="mb-3 d-flex flex-column gap-2">
          <button type="submit" class="btn btn-success">
            Upload HTML File
          </button>
          <input type="file"
                name="html"
                accept=".html"
                required
                class="form-control">
        </form>
        <!-- Create -->
        <form id="createHtmlForm"
              action="/admin/<%= page %>/create-html"
              method="POST"
              class="mb-2 d-flex flex-column gap-2">
          <button type="submit" class="btn btn-success">
            Create HTML
          </button>
          <input type="text"
                name="fileName"
                placeholder="New HTML file name"
                required
                class="form-control">
        </form>
        <!-- Rename -->
        <form id="renameForm"
              action="/admin/<%= page %>/rename"
              method="POST"
              class="d-flex flex-column gap-2">
          <input id="renameOldName" type="hidden" name="fileName">
          <button type="submit" class="btn btn-amber">
            Rename
          </button>
          <input id="renameNewName"
                type="text"
                name="newName"
                placeholder="New file name"
                required
                class="form-control">
        </form>
        <!-- Edit -->
        <button id="editBtn"
                type="button"
                class="btn btn-secondary w-100 mt-3">
          Edit
        </button>
        <!-- View -->
        <form id="viewForm"
              action="/admin/<%= page %>/view"
              method="GET"
              target="_blank"
              class="d-grid gap-2 mt-3">
          <input id="viewFileName"
                type="hidden"
                name="fileName">
          <button type="submit"
                  class="btn btn-outline-secondary">
            View
          </button>
        </form>
            <div class="d-flex gap-2 mt-3 mb-2">
              <form id="publishEnForm"
                      action="/admin/<%= page %>/publish-en"
                      method="POST"
                      class="flex-fill">
                <input id="publishEN" type="hidden"  name="fileName">
                <button type="submit" class="btn btn-primary w-100">
                    Publish EN
                </button>
              </form>
              <form id="publishEsForm"
                      action="/admin/<%= page %>/publish-es"
                      method="POST"
                      class="flex-fill">
                <input id="publishES" type="hidden" name="fileName">
                <button type="submit" class="btn btn-primary w-100">
                    Publish ES
                </button>
              </form>
            </div>
        <!-- Delete -->
        <form id="deleteForm"
              method="POST"
              action="/admin/<%= page %>/delete-file"
              class="mb-3 d-flex gap-2 align-items-center">
          <button type="button"
                  class="btn btn-danger"
                  id="deleteBtn">
            Delete
          </button>
          <input id="deleteFileName"
                type="hidden"
                name="fileName">
        </form>
      </div>
<!-- RIGHT COLUMN -->
      <div class="col-md-8 p-4">
        <h4>Files</h4>
        <div class="row mt-3">
<!-- FILE BROWSER -->
          <div class="col-md-7">
            <div class="border p-3">
              <div id="browser-container">
                <div id="browser" class="list-group"></div>
              </div>
            </div>
          </div>
<!-- WELCOME PANEL -->
          <div class="col-md-5">
            <div class="border p-3 mb-3 bg-light">
              <% if (msg && status) { %>
                <div id="server-feedback"
                     class="server-feedback <%= status %> border p-3 mt-3">
                  <%= msg %>
                </div>
              <% } %>
              <h5>Welcome, Samantha & Catalina!</h5>
              <p>
                This page allows you to manage the
                <strong>Mass Schedule Page</strong> of our parish website.
              </p>

              <p class="small">
                The Masses page communicates our regular worship schedule.
                It must be clear, accurate, and easy to read for parishioners
                and visitors.
              </p>

              <ul class="small">
                <li>You may <strong>upload existing HTML files</strong> or create new ones.</li>
                <li>You can <strong>edit files safely</strong> using the editor.</li>
                <li>The original file is never modified.</li>
                <li>When you edit a file, the system creates a new version with the same name plus the <strong>date and time of editing</strong>.</li>
                <li>After reviewing your changes in <strong>View mode</strong>, you may publish the page in <strong>English (EN)</strong> or <strong>Spanish (ES)</strong>.</li>
              </ul>

              <p class="small">
                Important guideline:
              </p>

              <ul class="small">
                <li>At the top of the page, clearly display any <strong>extraordinary or temporary schedule changes</strong> (for example: Christmas, Holy Week, Ash Wednesday, special feast days).</li>
                <li>Below that, present the <strong>regular weekly Mass schedule</strong>.</li>
              </ul>

              <p class="small mb-0">
                Thank you for your careful attention to keeping our parish schedule accurate and updated.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<script> window.ADMIN_PAGE = "<%= page %>";</script>
<script src="/js/tinymce/tinymce.min.js"></script>
<script src="/js/editor.js"></script>
<script src="/js/fetchFileList.js"></script>
<script src="/js/initDeleteModal.js"></script>
<script >
document.addEventListener('DOMContentLoaded', () => {
  editorHTML();
  initEditor();
  initEditButton();
  initSaveButtons();
  window.selectedFile = null;
  fetchFileList('/admin/' + window.ADMIN_PAGE + '/ls');
  initDeleteModal();
  const feedback = document.getElementById('server-feedback');
  if (!feedback) return;
  setTimeout(() => {
    feedback.remove();
  }, 6000);
});
</script>
</body>
